# Context is produced only by scoring-service/legacy-baseline/build.py.
FROM eclipse-temurin:17-jdk-jammy AS build
WORKDIR /build
COPY android /build/android
COPY scoring-service /build/scoring-service
COPY baseline-transport-provenance.json /build/baseline-transport-provenance.json
WORKDIR /build/scoring-service
RUN ./gradlew :service:installDist --no-daemon -x test

FROM eclipse-temurin:17-jre-jammy
ARG RELEASE_SHA
ARG TRANSPORT_PATCH_SHA256
ARG IDENTITY_PATCH_SHA256
LABEL org.opencontainers.image.revision=$RELEASE_SHA \
      io.frwhoop.algorithm.version="frwhoop-server-1" \
      io.frwhoop.baseline.commit="5caa31689da0023e111beb36850d3f81d67e1be2" \
      io.frwhoop.baseline.transport-sha256=$TRANSPORT_PATCH_SHA256 \
      io.frwhoop.baseline.identity-sha256=$IDENTITY_PATCH_SHA256
WORKDIR /app
COPY --from=build /build/scoring-service/service/build/install/service /app/
COPY --from=build /build/baseline-transport-provenance.json /app/
RUN printf '%s\n' "$RELEASE_SHA" | grep -Eq '^[0-9a-f]{40}$' \
    && printf '%s\n' "$TRANSPORT_PATCH_SHA256" | grep -Eq '^[0-9a-f]{64}$' \
    && printf '%s\n' "$IDENTITY_PATCH_SHA256" | grep -Eq '^[0-9a-f]{64}$' \
    && printf '%s\n' "$RELEASE_SHA" > /app/release.sha && chmod 444 /app/release.sha
ENV JAVA_OPTS="-Xmx1g -XX:+UseContainerSupport"
ENTRYPOINT ["/app/bin/service"]
