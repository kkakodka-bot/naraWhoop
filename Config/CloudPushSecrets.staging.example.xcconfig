// Staging cutover — copy to Config/CloudPushSecrets.xcconfig for a VPS-targeted build.
// Endpoint only; token must be a valid noop_ ingest token for a user on the VPS database.
// xcconfig parses // as a comment — write the URL as https:/$()/…
NOOP_PUSH_ENDPOINT = https:/$()/narawhoop.convexia.bio/functions/v1/push
NOOP_PUSH_TOKEN = noop_REPLACE_WITH_VPS_INGEST_TOKEN
NOOP_SUPABASE_ANON_KEY = REPLACE_WITH_VPS_ANON_KEY
