// Copy to Config/CloudPushSecrets.xcconfig (gitignored) and fill in.
// The endpoint is the deployed Supabase Edge Function; the token is a fleet ingest token minted
// against the noop_ingest_tokens table (see supabase/functions/_shared/tokens.ts).
// NB: xcconfig parses "//" as a comment — write the URL as https:/$()/… so it survives.
NOOP_PUSH_ENDPOINT = https:/$()/YOUR-PROJECT-REF.supabase.co/functions/v1/push
NOOP_PUSH_TOKEN = noop_REPLACE_WITH_FLEET_INGEST_TOKEN
NOOP_SUPABASE_ANON_KEY = REPLACE_WITH_SUPABASE_ANON_KEY
