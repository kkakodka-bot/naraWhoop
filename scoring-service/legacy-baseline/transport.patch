+import java.util.UUID
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicInteger
+
+class LegacyTransportTest {
+    private val user = UUID.fromString("00000000-0000-4000-8000-000000000001")
+    private val device = UUID.fromString("00000000-0000-4000-8000-000000000002")
+    private val item = ScoringWorkQueue.WorkItem(user, device, "2026-09-17", Instant.EPOCH,
+        Instant.EPOCH, 351, UUID.randomUUID(), UUID.randomUUID(), "UTC")
+    private fun bundle() = ServerScoreBundle(user, item.day, device.toString(), "frwhoop-server-1",
+        DayResult(DailyMetric(deviceId=device.toString(), day=item.day, avgHrv=42.0,
+            avgSdnn=55.0, restingHr=50, respRateBpm=14.0), emptyList(), emptyList(), null, null))
+
+    @Test fun writerSendsUnchangedBaselineMetricsWithExactClaimToFencedEndpoint() {
+        var sent: JSONObject? = null
+        val http = OkHttpClient.Builder().addInterceptor { chain ->
+            val request = chain.request()
+            assertEquals("/rpc/engine_publish_legacy_fenced", request.url.encodedPath)
+            val buffer = okio.Buffer()
+            request.body!!.writeTo(buffer)
+            sent = JSONObject(buffer.readUtf8())
+            Response.Builder().request(request).protocol(Protocol.HTTP_1_1).code(200)
+                .message("OK").body("{}".toResponseBody()).build()
+        }.build()
+        EngineIngestWriter("http://127.0.0.1", "fixture-role", "fixture-secret", http).write(bundle(), item)
+        val envelope = sent!!
+        assertEquals("fixture-secret", envelope.getString("p_secret"))
+        val payload = envelope.getJSONObject("p_payload")
+        assertEquals(user.toString(), payload.getString("user_id"))
+        assertEquals(device.toString(), payload.getString("device_id"))
+        assertEquals(item.day, payload.getString("day"))
+        assertEquals(351L, payload.getLong("input_revision"))
+        assertEquals(item.leaseToken.toString(), payload.getString("lease_token"))
+        assertEquals(item.runId.toString(), payload.getString("run_id"))
+        assertEquals("frwhoop-server-1", payload.getString("algorithm_version"))
+        val daily = payload.getJSONArray("daily_metrics").getJSONObject(0)
+        assertEquals(42.0, daily.getDouble("hrv_rmssd_ms"), 0.0)
+        assertEquals(55.0, daily.getDouble("hrv_sdnn_ms"), 0.0)
+        assertEquals(14.0, daily.getDouble("resp_rate_bpm"), 0.0)
+    }
+
+    @Test fun writerRejectsWrongOwnerDeviceDayOrVersionBeforeTransport() {
+        val calls = AtomicInteger()
+        val http = OkHttpClient.Builder().addInterceptor { calls.incrementAndGet(); error("must not send") }.build()
+        val writer = EngineIngestWriter("http://127.0.0.1", "fixture-role", "fixture-secret", http)
+        for (invalid in listOf(bundle().copy(userId=UUID.randomUUID()),
+            bundle().copy(deviceId=UUID.randomUUID().toString()), bundle().copy(day="2026-09-18"),
+            bundle().copy(algorithmVersion="frwhoop-physiology-2"))) {
+            try { writer.write(invalid, item); fail("claim mismatch accepted") } catch (_: IllegalArgumentException) {}
+        }
+        assertEquals(0, calls.get())
+    }
+
+    @Test fun stalePublicationIsNotRetriedThroughAnUnfencedEndpointOrLeakedToLogs() {
+        val calls = AtomicInteger()
+        val http = OkHttpClient.Builder().addInterceptor { chain ->
+            calls.incrementAndGet()
+            Response.Builder().request(chain.request()).protocol(Protocol.HTTP_1_1).code(409)
+                .message("Conflict").body("private health payload canary".toResponseBody()).build()
+        }.build()
+        try {
+            EngineIngestWriter("http://127.0.0.1", "fixture-role", "fixture-secret", http).write(bundle(), item)
+            fail("stale publication accepted")
+        } catch (failure: IllegalStateException) {
+            assertEquals("Fenced baseline publication failed: HTTP 409", failure.message)
+        }
+        assertEquals(1, calls.get())
+    }
+
+    @Test fun runningWorkRenewsAndOneLostLeaseRemainsLost() {
+        val renewals = CountDownLatch(2)
+        val calls = AtomicInteger()
+        RunningLegacyLease({ calls.incrementAndGet(); renewals.countDown(); true }, Duration.ofMillis(100)).use { lease ->
+            assertTrue("running work did not renew", renewals.await(3, TimeUnit.SECONDS))
+            assertTrue(lease.checkOwned())
+        }
+        assertTrue(calls.get() >= 2)
+        val failedCalls = AtomicInteger()
+        RunningLegacyLease({ failedCalls.incrementAndGet() > 1 }, Duration.ofHours(1)).use { lease ->
+            assertFalse(lease.checkOwned())
+            assertFalse(lease.checkOwned())
+            assertEquals(1, failedCalls.get())
+        }
+    }
+
+    @Test fun renewalExceptionFencesPublication() {
+        RunningLegacyLease({ error("connection unavailable") }, Duration.ofHours(1)).use { lease ->
+            assertFalse(lease.checkOwned())
+            assertFalse(lease.checkOwned())
+        }
+    }
+}
