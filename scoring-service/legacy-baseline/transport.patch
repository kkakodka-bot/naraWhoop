+/** Requires the repair branch's disposable PostgreSQL schema, including the v1 fence migration. */
+class LegacyQueueIntegrationTest {
+    private lateinit var db: PostgresClient
+    private lateinit var queue: ScoringWorkQueue
+    private val user = UUID.randomUUID()
+    private val device = UUID.randomUUID()
+    private val day = "2026-09-17"
+
+    @Before fun setup() {
+        val url = System.getenv("PHYSIOLOGY_TEST_DATABASE_URL")
+        assumeTrue("Provide the disposable physiology_queue_test cluster", url != null)
+        require(url!!.contains("@127.0.0.1:") && url.endsWith("/physiology_queue_test"))
+        db = PostgresClient(url)
+        queue = ScoringWorkQueue(db)
+        sql("insert into auth.users values ('$user')")
+        sql("insert into profiles(id,timezone) values ('$user','UTC')")
+        sql("insert into devices(id,user_id) values ('$device','$user')")
+    }
+
+    @After fun close() { if (::db.isInitialized) db.close() }
+
+    @Test fun newRevisionFencesEveryOldLeaseMutation() {
+        queue.dirtyWorkItem(user, device, day)
+        val old = claim()
+        queue.dirtyWorkItem(user, device, day)
+        val fresh = claim()
+        assertTrue(fresh.inputRevision > old.inputRevision)
+        assertNotEquals(old.leaseToken, fresh.leaseToken)
+        assertFalse(queue.renew(old))
+        assertFalse(queue.markDone(old, 1))
+        assertFalse(queue.markWaiting(old, "obsolete waiting"))
+        assertFalse(queue.markFailed(old, "obsolete failure"))
+        assertTrue(queue.renew(fresh))
+        assertEquals(fresh.leaseToken.toString(), scalarText("select lease_token::text from scoring_work_items where user_id='$user'"))
+    }
+
+    @Test fun expiredLeaseCannotReleaseSuccessor() {
+        queue.dirtyWorkItem(user, device, day)
+        val expired = claim()
+        alterQueue("update scoring_work_items set lease_expires_at=clock_timestamp()-interval '1 second' where user_id='$user'")
+        assertFalse(queue.renew(expired))
+        val successor = claim()
+        assertFalse(queue.markFailed(expired, "expired failure"))
+        assertFalse(queue.markDone(expired, 1))
+        assertTrue(queue.renew(successor))
+    }
+
+    @Test fun twoWorkersClaimOnlyOneLiveRevision() {
+        queue.dirtyWorkItem(user, device, day)
+        val start = CountDownLatch(1)
+        val pool = Executors.newFixedThreadPool(2)
+        try {
+            val results = (1..2).map { pool.submit<ScoringWorkQueue.WorkItem?> {
+                start.await(); queue.claimOne(user, device, day)
+            } }
+            start.countDown()
+            assertEquals(1, results.map { it.get(10, TimeUnit.SECONDS) }.count { it != null })
+        } finally { pool.shutdownNow() }
+    }
+
+    @Test fun waitingDoesNotExhaustFailuresAndNewDataResetsFailureBudget() {
+        queue.dirtyWorkItem(user, device, day)
+        assertTrue(queue.markWaiting(claim(), "no hr/rr inputs"))
+        assertEquals("0", scalarText("select consecutive_failures::text from scoring_work_items where user_id='$user'"))
+        assertNull(queue.claimOne(user, device, day))
+        repeat(8) {
+            alterQueue("update scoring_work_items set next_attempt_at=clock_timestamp()-interval '1 second' where user_id='$user'")
+            assertTrue(queue.markFailed(claim(), "controlled failure"))
+        }
+        alterQueue("update scoring_work_items set next_attempt_at=clock_timestamp()-interval '1 second' where user_id='$user'")
+        assertNull(queue.claimOne(user, device, day))
+        queue.dirtyWorkItem(user, device, day)
+        assertNotNull(queue.claimOne(user, device, day))
+    }
+
+    @Test fun actualFrozenReplayPublishesThroughItsFencedRpcAndCreatesImmutableArchiveDebt() {
+        val writer = rpcWriter()
+        val input = input()
+        val provider = object : ScoreInputProvider {
+            override fun loadDay(userId: UUID, day: String, deviceId: UUID) = input
+        }
+        poller(provider, writer).scoreDay(user, device, day)
+        assertEquals("done", scalarText("select status from scoring_work_items where user_id='$user'"))
+        assertEquals("1", scalarText("select count(*)::text from server_physiology_results where user_id='$user' and algorithm_version='frwhoop-server-1'"))
+        assertEquals("1", scalarText("select count(*)::text from physiology_archive_outbox where user_id='$user' and algorithm_version='frwhoop-server-1' and object_key like '%/revisions/1/%'"))
+        val stored = JSONObject(scalarText("select payload::text from server_physiology_results where user_id='$user'"))
+        val expected = EngineIngestWriter.buildPayload(DayScorer().score(input, "frwhoop-server-1"))
+            .getJSONArray("daily_metrics").getJSONObject(0)
+        for (key in listOf("hrv_rmssd_ms", "hrv_sdnn_ms", "resting_hr_bpm", "resp_rate_bpm", "sleep_total_min")) {
+            val actual = stored.getJSONObject("daily")
+            if (expected.isNull(key)) assertTrue(key, actual.isNull(key))
+            else assertEquals(key, expected.getDouble(key), actual.getDouble(key), 0.0)
+        }
+    }
+
+    @Test fun obsoleteReplayCannotPublishOrReleaseCurrentWorker() {
+        var successor: ScoringWorkQueue.WorkItem? = null
+        var transportCalls = 0
+        val provider = object : ScoreInputProvider {
+            override fun loadDay(userId: UUID, day: String, deviceId: UUID): SignalSampleReader.DayInputs {
+                queue.dirtyWorkItem(user, device, day)
+                successor = claim()
+                return input()
+            }
+        }
+        val http = OkHttpClient.Builder().addInterceptor { transportCalls++; error("obsolete worker sent a result") }.build()
+        try {
+            poller(provider, EngineIngestWriter("http://127.0.0.1", "fixture-role", "test", http)).scoreDay(user, device, day)
+            fail("superseded replay reported completion")
+        } catch (_: IllegalStateException) {}
+        assertEquals(0, transportCalls)
+        assertEquals(successor!!.leaseToken.toString(), scalarText("select lease_token::text from scoring_work_items where user_id='$user'"))
+        assertTrue(queue.renew(successor!!))
+    }
+
+    private fun input(): SignalSampleReader.DayInputs {
+        val start = java.time.Instant.parse("2026-09-17T00:00:00Z").epochSecond
+        return SignalSampleReader.DayInputs(user, day, device.toString(), 0L, start, start+86399,
+            UserProfile(age=35.0, sex="male"), start-43200, start+43200,
+            (0..359).map { HrSample(device.toString(), start+it*60L, 52) }, emptyList(), emptyList(),
+            emptyList(), emptyList(), DeviceFamily.WHOOP5)
+    }
+
+    private fun poller(provider: ScoreInputProvider, writer: EngineIngestWriter) = ScoringPoller(
+        ScoringConfig("unused", "test", "http://127.0.0.1", "fixture-role"), provider, queue,
+        DayScorer(), writer, HeartbeatReporter(db, "frwhoop-server-1"))
+
+    private fun rpcWriter(): EngineIngestWriter {
+        val http = OkHttpClient.Builder().addInterceptor { chain ->
+            assertEquals("/rpc/engine_publish_legacy_fenced", chain.request().url.encodedPath)
+            val buffer = okio.Buffer()
+            chain.request().body!!.writeTo(buffer)
+            val envelope = JSONObject(buffer.readUtf8())
+            val result = db.withConnection { connection ->
+                connection.prepareStatement("select engine_publish_legacy_fenced(?, ?::jsonb)::text").use { ps ->
+                    ps.setString(1, envelope.getString("p_secret"))
+                    ps.setString(2, envelope.getJSONObject("p_payload").toString())
+                    ps.executeQuery().use { rows -> check(rows.next()); rows.getString(1) }
+                }
+            }
+            Response.Builder().request(chain.request()).protocol(Protocol.HTTP_1_1).code(200)
+                .message("OK").body(result.toResponseBody()).build()
+        }.build()
+        return EngineIngestWriter("http://127.0.0.1", "fixture-role", "test", http)
+    }
+
+    private fun alterQueue(statement: String) = db.withConnection { connection ->
+        connection.autoCommit = false
+        try {
+            connection.createStatement().use { s ->
+                s.execute("select set_config('physiology.legacy_queue_write', txid_current()::text, true)")
+                s.execute(statement)
+            }
+            connection.commit()
+        } finally { connection.rollback(); connection.autoCommit = true }
+    }
+
+    private fun claim() = queue.claimOne(user, device, day) ?: error("baseline work was not runnable")
+    private fun sql(statement: String) = db.withConnection { connection ->
+        connection.createStatement().use { it.execute(statement) }
+    }
+    private fun scalarText(statement: String): String = db.withConnection { connection ->
+        connection.createStatement().use { s -> s.executeQuery(statement).use { r -> check(r.next()); r.getString(1) } }
+    }
+}
