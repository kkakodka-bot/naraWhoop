+/** A renewal failure is terminal for this run, even if a later renewal would succeed. */
+internal class RunningLegacyLease(
+    private val renew: () -> Boolean,
+    interval: Duration,
+) : AutoCloseable {
+    private val lost = AtomicBoolean(false)
+    private val executor = Executors.newSingleThreadScheduledExecutor { runnable ->
+        Thread(runnable, "baseline-lease-renewal").apply { isDaemon = true }
+    }
+
+    init {
+        val periodMillis = interval.toMillis().coerceAtLeast(100)
+        executor.scheduleAtFixedRate({ checkOwned() }, periodMillis, periodMillis, TimeUnit.MILLISECONDS)
+    }
+
+    fun checkOwned(): Boolean {
+        if (lost.get()) return false
+        val current = try { renew() } catch (_: Exception) { false }
+        if (!current) lost.set(true)
+        return !lost.get()
+    }
+
+    override fun close() {
+        executor.shutdownNow()
     }
 }
