+/** Fixed admission for one process. This never reads replay variables or mutable defaults. */
+class BaselineAdmission private constructor(val ownerId: UUID?, val deviceId: UUID?) {
+    fun requireScope(owner: UUID, device: UUID) {
+        if (ownerId != null && (ownerId != owner || deviceId != device)) throw BaselineAdmissionViolation()
+    }
+
+    companion object {
+        fun fromEnvironment(env: Map<String, String>): BaselineAdmission {
+            val owner = env["SCORING_CANARY_OWNER_ID"]
+            val device = env["SCORING_CANARY_DEVICE_ID"]
+            return when (env["SCORING_ADMISSION_MODE"]) {
+                "all-eligible" -> {
+                    require(owner == null && device == null) { "Unexpected canary scope in all-eligible mode" }
+                    BaselineAdmission(null, null)
+                }
+                "canary" -> BaselineAdmission(canonicalUUID(owner), canonicalUUID(device))
+                else -> error("Explicit baseline admission mode required")
+            }
+        }
+
+        private fun canonicalUUID(value: String?): UUID {
+            require(value != null) { "Complete canary owner and device required" }
+            val parsed = try { UUID.fromString(value) } catch (_: IllegalArgumentException) {
+                throw IllegalArgumentException("Invalid canary scope")
+            }
+            require(parsed != UUID(0, 0) && parsed.toString() == value) { "Invalid canary scope" }
+            return parsed
+        }
+    }
+}
+
+class BaselineAdmissionViolation : IllegalStateException("baseline_admission_scope_mismatch")
